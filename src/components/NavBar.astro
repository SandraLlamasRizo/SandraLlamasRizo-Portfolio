---
import logo from '@/assets/logo.png'
import purple from '@/assets/purple_cloud.png'
const currentPath = Astro.url.pathname;
---

<nav>
    <div>
        <figure><img id="logo" src={logo.src} alt=""></figure>
        <a href="/"><h5>SLR</h5></a>
    </div>
    <div class="links">
        <a href="/work" class={currentPath === "/work" ? "active" : ""}><h5>WORK</h5></a>
        <a href="/about" class={currentPath === "/about" ? "active" : ""}><h5>ABOUT</h5></a>
        <a href="/contact" class={currentPath === "/contact" ? "active" : ""}><h5>CONTACT</h5></a>
        <a href="/cv"><h5>CV</h5></a>
    </div>
</nav>

<style>
    nav {
        width: 100%;
        display: flex;
        justify-content: space-between;
        height: 80px;
        max-width: 1000px;
        margin: 0 auto;
    }

    nav div {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    figure {
        margin: 0;
        padding: 0;
    }

    img {
        height: 30px;
        width: auto;
    }

    .active {
        color: var(--primary-hover);
    }


</style>